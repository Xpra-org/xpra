################################################################################
# Network Connection

# Enable shared memory transfers:
# this can also be a list of paths, separated by the path separator:
# each one is either the file to use for one mmap area,
# or a directory where the mmap files can be found
mmap = %(mmap)s

# Set group ownership of the mmap file:
#leave it as it is:
#mmap-group = no
#use a specific group:
#mmap-group = xpra
#use the server socket's group:
#mmap-group = SOCKET
#use the "xpra" group if possible, or fallback to the socket's group:
mmap-group = auto

# The file permissions set on the server's unix domain socket
# (ignored when mmap-group is enabled)
#socket-permissions = 660
socket-permissions = 600

# Share session with other users:
#sharing = yes
#sharing = no
# 'sync' also synchronizes the window geometry, focus and pointer between clients,
# individual subsystems can be selected using a comma separated list:
#sharing = sync
#sharing = sync-position,sync-focus,sync-pointer
# 'combine' gives each client its own area of the virtual display,
# with the clients' monitors placed side by side:
# (requires a seamless server with RandR 1.6 and XPRA_BACKWARDS_COMPATIBLE=0)
#sharing = combine
# Leave it up to the client, where it defaults to no
# and this setting can then be changed from the system tray menu:
sharing = auto

# Allow sessions to be locked:
#lock = no
#lock = yes
# Leave it up to the client, where it defaults to no
# and this setting can then be changed from the system tray menu:
lock = auto

# Socket directories (may be specified more than once):
#socket-dirs = /tmp
#socket-dirs = ~/.xpra
#socket-dirs = /run/xpra
%(socket_dirs)s

# Where to create and look for sockets:
# all "socket-dirs" entries are used.
# "socket-dir" is deprecated.

# Session idle timeout in seconds:
#idle-timeout = 120
idle-timeout = 0

# Server idle timeout in seconds:
#server-idle-timeout = 600
server-idle-timeout = 0

# Bandwidth limit:
#no limit:
#bandwidth-limit = 0
#1Mbps:
#bandwidth-limit = 1000000
#bandwidth-limit = 1000Kbps
#bandwidth-limit = 1M
#10Mbps:
#bandwidth-limit = 10Mbps
bandwidth-limit = auto
