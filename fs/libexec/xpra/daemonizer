#!/usr/bin/env python3

import os.path
import signal
import sys


def main(argv: list[str]) -> int:
    """
    Daemonizes the process and runs the specified command.
    The PID of the child process is written to the specified pidfile.
    """
    if not os.path.exists("/dev/null"):
        sys.stderr.write("This platform does not support daemonization.\n")
        return 1

    if not os.access("/dev/null", os.W_OK):
        sys.stderr.write("Cannot write to /dev/null\n")
        return 1

    if len(argv) < 3 or argv[1] in ("--help", "-h") or sys.argv[2] != "--":
        sys.stderr.write("Usage: daemonizer pidfile -- [command] [args...]")
        return 1

    pidfile = sys.argv[1]
    if pidfile == "-":
        pidfile = "/dev/stdout"
    elif not os.path.isabs(pidfile):
        pidfile = os.path.abspath(pidfile)

    from xpra.util.io import livefds
    from xpra.util.daemon import daemonize
    from xpra.util.env import envbool
    kill_process_group = envbool("XPRA_KILL_CHILD_PROCESS_GROUP", True)
    daemonize()

    from subprocess import Popen
    command = sys.argv[3:]
    proc = None
    try:
        proc = Popen(command, close_fds=True, start_new_session=kill_process_group)
        pid = proc.pid

        with open(pidfile, "wb") as f:
            f.write(f"{pid}\n".encode("latin1"))
            f.flush()
            os.fsync(f.fileno())

        fds = livefds()
        for fd in fds:
            try:
                os.close(fd)
            except Exception:
                pass
        return proc.wait()
    except Exception:
        return 1
    finally:
        if proc and kill_process_group:
            # The command is no longer Xpra's child after the double fork,
            # so clean up its group here without depending on Xpra's reaper.
            try:
                os.killpg(proc.pid, signal.SIGTERM)
            except OSError:
                pass
        try:
            os.unlink(pidfile)
        except Exception:
            pass


if __name__ == "__main__":
    sys.exit(main(sys.argv))
